{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["cle1"],
  "functions": {"api/index.js": {"maxDuration": 60}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
