DATABASE_URL=postgresql://postgres:password@localhost:5432/er_landing
DATABASE_SSL=false
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:3002
HOST=127.0.0.1
PORT=3001

# Usuario inicial que crea npm run db:seed-admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD

# Opcional: inicio de sesion con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para compilar GitHub Pages con una API remota (no usar en el VPS).
# VITE_API_ORIGIN=https://admin.tudominio.com
# VITE_BASE_PATH=/ER-LandigPage/

# Solo en el servidor cloud; conservar vacío para usar uploads/ local.
STORAGE_DRIVER=local
STORAGE_BUCKET=uploads
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# VITE_DIRECT_UPLOADS=true
