# Only the hostname, without https:// or trailing slash.
DOMAIN=admin.example.com
PUBLIC_SITE_ORIGIN=https://emr1195.github.io
# Generate each secret separately: openssl rand -hex 32
# Use hexadecimal for POSTGRES_PASSWORD (safe inside DATABASE_URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
BETTER_AUTH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
