{
  "name": "er-lp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "db:create": "node server/scripts/create-database.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed-admin": "node server/scripts/seed-admin.js",
    "db:seed-demo": "node server/scripts/seed-demo.js",
    "db:setup": "npm run db:create && npm run db:migrate && npm run db:seed-admin",
    "lint": "eslint src server vite.config.js --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "design:preview": "python -m http.server 5197 --bind 127.0.0.1 --directory .design/dashboard-redesign",
    "test": "set TZ=utc && jest --passWithNoTests --watchAll=false --maxWorkers=50%",
    "test:watch": "jest --watchAll",
    "test:e2e": "npm run build && playwright test",
    "walkthrough:rehearse": "node scripts/walkthrough/record.mjs --rehearsal",
    "walkthrough:record": "node scripts/walkthrough/record.mjs",
    "walkthrough:render": "python -X utf8 scripts/walkthrough/render.py",
    "test:ultra": "set TZ=utc && jest --passWithNoTests --watchAll=false --maxWorkers=100% "
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-presigned-post": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@reduxjs/toolkit": "^2.0.1",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "babel-jest": "^29.7.0",
    "better-auth": "^1.7.10",
    "concurrently": "^10.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "6.30.4",
    "whatwg-fetch": "^3.6.20",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "vite": "^5.4.21"
  }
}
